# PostgreSQL on VPS (tables in schema "abgp": prant_profiles, content, complaints)
DATABASE_URL=postgresql://USER:PASSWORD@207.180.226.196:5432/DATABASE_NAME

# Firebase Admin (auth only): verify ID tokens and manage prant users
# Option A: service account JSON path
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: inline env vars from Firebase Console → Project settings → Service accounts
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# API port (backend listens on 0.0.0.0 so reachable via VPS IP)
PORT=3001

# Razorpay (server-side only — never expose KEY_SECRET to the frontend)
# Use rzp_test_* keys for local development; rzp_live_* for production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Membership fee in paise (amount is set only on the server).
# Production (NODE_ENV=production): defaults to 10000 (₹100) when unset.
# Local dev: defaults to 10000 (₹100) when unset. Override explicitly if needed:
# MEMBERSHIP_AMOUNT_PAISE=10000

# Donations: run backend/migrations/008_donations_table.sql on PostgreSQL.
# Razorpay Dashboard → Website & App settings: whitelist your production domain(s).

# Membership receipt welcome email (second email with PDF — Razorpay email stays unchanged)
# Run backend/migrations/010_receipt_email_sent.sql on PostgreSQL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user@gmail.com
# SMTP_PASS=your-app-password
# MEMBERSHIP_RECEIPT_FROM=membership@abgpindia.in
# MEMBERSHIP_RECEIPT_FROM_NAME=Akhil Bhartiya Grahak Panchayat
# ABGP_BUSINESS_NAME=Abgpindia
# ABGP_GSTIN=your-gstin
# ABGP_WEBSITE_URL=https://abgpindia.in
# ABGP_SUPPORT_EMAIL=vijaysagar1963@gmail.com
# ABGP_SUPPORT_PHONE=
